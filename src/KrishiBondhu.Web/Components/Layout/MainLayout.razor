@inherits LayoutComponentBase
@inject ILocalizationService Loc
@inject NavigationManager Nav
@inject IAuthService AuthService

<div class="d-flex flex-column min-vh-100">
    <!-- Top Navigation Bar -->
    <header class="kb-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <!-- Brand -->
            <a class="kb-brand" href="">
                <div class="kb-brand-icon">
                    <i class="bi bi-tree"></i>
                </div>
                <div>
                    <div style="font-size: 1.25rem; font-weight: 800; line-height: 1.1;">কৃষিবন্ধু</div>
                    <div style="font-size: 0.72rem; font-weight: 500; opacity: 0.85; letter-spacing: 0.5px;">DECISION ENGINE</div>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-1">
                <a class="kb-nav-link" href="">
                    <i class="bi bi-house me-1"></i> @(Loc.CurrentLanguage == "bn" ? "হোম" : "Home")
                </a>
                <a class="kb-nav-link" href="market-prices">
                    <i class="bi bi-graph-up-arrow me-1"></i> @(Loc.CurrentLanguage == "bn" ? "দৈনিক বাজারদর" : "Daily Prices")
                </a>
                <a class="kb-nav-link" href="complaints/submit">
                    <i class="bi bi-shield-check me-1"></i> @(Loc.CurrentLanguage == "bn" ? "ভোক্তা অভিযোগ" : "Complaints")
                </a>
                <a class="kb-nav-link" href="lots">
                    <i class="bi bi-basket me-1"></i> @(Loc.CurrentLanguage == "bn" ? "ফসলের লটসমূহ" : "Harvest Lots")
                </a>
                <a class="kb-nav-link" href="demands">
                    <i class="bi bi-megaphone me-1"></i> @(Loc.CurrentLanguage == "bn" ? "ক্রেতার চাহিদা" : "Buyer Demands")
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a class="kb-nav-link" href="orders">
                            <i class="bi bi-receipt me-1"></i> @(Loc.CurrentLanguage == "bn" ? "অর্ডার ও লেনদেন" : "Orders")
                        </a>
                        <a class="kb-nav-link" href="disputes">
                            <i class="bi bi-shield-exclamation me-1"></i> @(Loc.CurrentLanguage == "bn" ? "বিরোধ নিষ্পত্তি" : "Disputes")
                        </a>
                    </Authorized>
                </AuthorizeView>

                <!-- Support Staff & Admin Reviews -->
                <AuthorizeView Roles="Administrator,SupportAgent">
                    <Authorized>
                        <a class="kb-nav-link" href="complaints/review">
                            <i class="bi bi-shield-shaded me-1"></i> @(Loc.CurrentLanguage == "bn" ? "অভিযোগ তদন্ত" : "Review Complaints")
                        </a>
                    </Authorized>
                </AuthorizeView>

                <!-- Admin Console (Only Administrator) -->
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <a class="kb-nav-link" href="admin">
                            <i class="bi bi-speedometer2 me-1"></i> @(Loc.CurrentLanguage == "bn" ? "প্রশাসন" : "Admin")
                        </a>
                    </Authorized>
                </AuthorizeView>
            </nav>

            <!-- User / Auth / Language Controls -->
            <div class="d-flex align-items-center gap-2">
                <!-- Language Switch Toggle -->
                <button type="button" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1" @onclick="ToggleLanguage" style="border-radius: 20px; font-weight: 600; font-size: 0.85rem;">
                    <i class="bi bi-translate"></i>
                    <span>@(Loc.CurrentLanguage == "bn" ? "English" : "বাংলা")</span>
                </button>

                <!-- Auth Buttons or Profile Dropdown -->
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light dropdown-toggle d-flex align-items-center gap-2 fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 20px;">
                                <i class="bi bi-person-circle text-success"></i>
                                <span>@(context.User.Identity?.Name ?? "ব্যবহারকারী")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width: 240px; border-radius: 12px;">
                                <li>
                                    <div class="px-3 py-2 bg-light rounded-top border-bottom">
                                        <div class="small text-secondary">লগইন ব্যবহারকারী: <strong>@(context.User.Identity?.Name)</strong></div>
                                        <div class="mt-1">
                                            <span class="badge bg-success text-white">
                                                @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                                            </span>
                                        </div>
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="dashboard">
                                        <i class="bi bi-grid me-2 text-primary"></i>ড্যাশবোর্ড (Dashboard)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="orders">
                                        <i class="bi bi-receipt me-2 text-secondary"></i>আমার অর্ডার (My Orders)
                                    </a>
                                </li>

                                <!-- Farmer Specific -->
                                <AuthorizeView Roles="Farmer" Context="farmerCtx">
                                    <Authorized>
                                        <li>
                                            <a class="dropdown-item py-2" href="lots">
                                                <i class="bi bi-basket me-2 text-success"></i>আমার ফসলের লট (My Lots)
                                            </a>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>

                                <!-- Buyer Specific -->
                                <AuthorizeView Roles="Buyer" Context="buyerCtx">
                                    <Authorized>
                                        <li>
                                            <a class="dropdown-item py-2" href="demands">
                                                <i class="bi bi-megaphone me-2 text-warning"></i>আমার চাহিদা পোস্ট (My Demands)
                                            </a>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>

                                <!-- Crops Directory -->
                                <li>
                                    <a class="dropdown-item py-2" href="crops">
                                        <i class="bi bi-flower1 me-2 text-success"></i>ফসলের ক্যাটালগ (Crops)
                                    </a>
                                </li>

                                <!-- SupportAgent & Administrator Officer Tools -->
                                <AuthorizeView Roles="Administrator,SupportAgent" Context="staffCtx">
                                    <Authorized>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <div class="dropdown-header small text-muted text-uppercase fw-bold pb-1" style="font-size: 0.72rem;">
                                                কর্মকর্তা ও প্রশাসনিক টুলস
                                            </div>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" href="market-prices/entry">
                                                <i class="bi bi-pencil-square me-2 text-primary"></i>বাজারদর এন্ট্রি (Price Entry)
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" href="complaints/review">
                                                <i class="bi bi-shield-check me-2 text-warning"></i>অভিযোগ পর্যালোচনা (Review Complaints)
                                            </a>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>

                                <!-- Administrator Only -->
                                <AuthorizeView Roles="Administrator" Context="adminCtx">
                                    <Authorized>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item py-2 text-danger fw-semibold" href="admin">
                                                <i class="bi bi-speedometer2 me-2"></i>এডমিন কনসোল (Admin Panel)
                                            </a>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>

                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>লগআউট (Logout)
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="login" class="btn btn-sm btn-outline-light fw-bold px-3" style="border-radius: 20px;">
                                <i class="bi bi-box-arrow-in-right me-1"></i>লগইন
                            </a>
                            <a href="register" class="btn btn-sm btn-warning text-dark fw-bold px-3" style="border-radius: 20px;">
                                <i class="bi bi-person-plus me-1"></i>নিবন্ধন
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-grow-1">
        <div class="container-fluid px-3 px-md-5 py-4">
            @Body
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light py-4 mt-auto border-top border-secondary">
        <div class="container-fluid px-3 px-md-5">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span class="fw-bold text-success">কৃষিবন্ধু ডিসিশন ইঞ্জিন</span> — বাংলাদেশের কৃষকদের ন্যায্যমূল্য ও স্বচ্ছ বাণিজ্যের বিশ্বস্ত প্রযুক্তি।
                </div>
                <div class="col-md-6 text-center text-md-end text-muted small">
                    নিরাপদ ওডিটিং ও ডিজিটাল স্কেল যাচাইকরণ ব্যবস্থা &copy; ২০২৬ | KrishiBondhu MVP
                </div>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" style="display: none;" data-nosnippet>
    একটি অপ্রত্যাশিত সমস্যা দেখা দিয়েছে।
    <a href="." class="reload">রিলোড করুন</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void ToggleLanguage()
    {
        if (Loc.CurrentLanguage == "bn")
        {
            Loc.SetLanguage("en");
        }
        else
        {
            Loc.SetLanguage("bn");
        }
        StateHasChanged();
    }
}
