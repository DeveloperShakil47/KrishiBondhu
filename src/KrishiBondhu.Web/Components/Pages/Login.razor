@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>লগইন | কৃষিবন্ধু ডিসিশন ইঞ্জিন</PageTitle>

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="kb-card">
            <div class="text-center mb-4">
                <div class="kb-brand-icon mx-auto mb-2" style="width: 52px; height: 52px; font-size: 1.8rem;">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3 class="fw-bold mb-1">অ্যাকাউন্টে প্রবেশ করুন</h3>
                <p class="text-muted small">কৃষিবন্ধু প্ল্যাটফর্মে আপনার মোবাইল বা ইমেইল দিয়ে লগইন করুন</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <div>@errorMessage</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success d-flex align-items-center gap-2 py-2" role="alert">
                    <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                    <div>@successMessage</div>
                </div>
            }

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">মোবাইল নম্বর বা ইমেইল</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-phone"></i></span>
                        <InputText @bind-Value="loginModel.Identifier" class="form-control" placeholder="যেমন: 01711000001" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Identifier)" class="text-danger small mt-1" />
                </div>

                <div class="mb-3">
                    <label class="form-label">পাসওয়ার্ড</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <InputText type="password" @bind-Value="loginModel.Password" class="form-control" placeholder="••••••••" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small mt-1" />
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="loginModel.RememberMe" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label small" for="rememberMe">লগইন মনে রাখুন</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-kb-primary w-100 justify-content-center py-2 mb-3" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>যাচাই করা হচ্ছে...</span>
                    }
                    else
                    {
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        <span>লগইন করুন</span>
                    }
                </button>
            </EditForm>

            <div class="text-center small border-top pt-3">
                অ্যাকাউন্ট নেই? <a href="register" class="fw-bold text-success text-decoration-none">নতুন অ্যাকাউন্ট তৈরি করুন</a>
            </div>

            <!-- Quick Demo Role Switcher -->
            <div class="mt-4 pt-3 border-top">
                <span class="text-muted small fw-bold d-block mb-2 text-center">
                    <i class="bi bi-magic me-1"></i> ডেমো মূল্যায়নের জন্য এক-ক্লিকে ভূমিকা পূরণ:
                </span>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="@(() => FillCredentials("01711000001", "KrishiPassword@2026!"))">
                        কৃষক (Farmer)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning text-dark" @onclick="@(() => FillCredentials("01811000002", "KrishiPassword@2026!"))">
                        ব্যবসায়ী (Buyer)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="@(() => FillCredentials("01911000003", "KrishiPassword@2026!"))">
                        ওজন পরিমাপক (Operator)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => FillCredentials("01611000004", "KrishiPassword@2026!"))">
                        সহায়তাকারী (Support)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => FillCredentials("admin@krishibondhu.gov.bd", "AdminSecurePassword@2026!"))">
                        প্রশাসক (Admin)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private LoginDto loginModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Error))
        {
            errorMessage = Error;
        }
    }

    private void FillCredentials(string identifier, string password)
    {
        loginModel.Identifier = identifier;
        loginModel.Password = password;
        errorMessage = null;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var result = await AuthService.GenerateSignInTokenAsync(loginModel);
            if (result.Succeeded && !string.IsNullOrEmpty(result.Data))
            {
                successMessage = "লগইন সফল হয়েছে! ড্যাশবোর্ডে নেওয়া হচ্ছে...";
                var url = $"/api/auth/sign-in?token={result.Data}";
                if (!string.IsNullOrEmpty(ReturnUrl))
                {
                    url += $"&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
                }
                Nav.NavigateTo(url, forceLoad: true);
            }
            else
            {
                errorMessage = result.Errors.FirstOrDefault() ?? "লগইন ব্যর্থ হয়েছে।";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"একটি সমস্যা হয়েছে: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
