@page "/market-prices/entry"
@attribute [Authorize(Roles = "Administrator,SupportAgent,WeighingOperator")]
@rendermode InteractiveServer
@inject IMarketPriceService PriceService
@inject ICropService CropService
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>বাজারদর পর্যবেক্ষণ এন্ট্রি — কৃষিবন্ধু</PageTitle>

<div class="container py-4" style="max-width: 900px;">
    <!-- Breadcrumb & Back -->
    <div class="mb-3">
        <a href="market-prices" class="text-decoration-none text-success fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> দৈনিক বাজারদর ড্যাশবোর্ডে ফিরুন
        </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 18px;">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-success text-white rounded-circle">
                    <i class="bi bi-pencil-square fs-4"></i>
                </div>
                <div>
                    <h1 class="h4 fw-bold text-dark mb-1">📝 দৈনিক বাজারদর পর্যবেক্ষণ এন্ট্রি</h1>
                    <p class="text-muted small mb-0">মাঠপর্যায়ের মোকাম বা আড়ত থেকে সংগৃহীত প্রকৃত বেচাকেনার মূল্য তথ্য অন্তর্ভুক্ত করুন</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (isSuccess)
            {
                <div class="alert alert-success p-4 rounded-3 text-center my-3">
                    <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                    <h4 class="fw-bold">মূল্য পর্যবেক্ষণ সফলভাবে সংরক্ষিত হয়েছে!</h4>
                    <p class="text-secondary mb-3">পূর্বের কোনো রেকর্ড মুছে ফেলা হয়নি, অডিট লগ এবং ঐতিহাসিক তথ্য অবিকৃত রয়েছে।</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-outline-success" @onclick="ResetForm">আরেকটি এন্ট্রি করুন</button>
                        <a href="market-prices" class="btn btn-success">বাজারদর ড্যাশবোর্ডে দেখুন</a>
                    </div>
                </div>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <!-- Crop Selection & Quick Add Crop -->
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold small mb-0">পণ্য / ফসল <span class="text-danger">*</span></label>
                                <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-semibold" @onclick="() => showQuickAddCropModal = true">
                                    <i class="bi bi-plus-circle me-1"></i>+ নতুন ফসল যুক্ত করুন
                                </button>
                            </div>
                            <select class="form-select border-success" @bind="model.CropId" @bind:after="UpdateNormalizedPreview">
                                <option value="@Guid.Empty">-- ফসল নির্বাচন করুন --</option>
                                @foreach (var c in crops)
                                {
                                    <option value="@c.Id">@c.IconEmoji @c.NameBn (@c.Category)</option>
                                }
                            </select>
                            <ValidationMessage For="() => model.CropId" class="text-danger small" />
                        </div>

                        <!-- Data Source -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">তথ্যের উৎস <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="model.PriceSourceId">
                                <option value="@Guid.Empty">-- উৎস নির্বাচন করুন --</option>
                                @foreach (var s in sources)
                                {
                                    <option value="@s.Id">@s.NameBn @(s.IsOfficialAuthority ? "⭐" : "")</option>
                                }
                            </select>
                            <ValidationMessage For="() => model.PriceSourceId" class="text-danger small" />
                        </div>

                        <!-- Location & Market Section -->
                        <div class="col-12 pt-2">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold small text-dark">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> বাজার ও ভৌগোলিক অবস্থান নির্বাচন (৬৪ জেলা ও সকল উপজেলা)
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-success fw-semibold" @onclick="OpenAddMarketModal">
                                        <i class="bi bi-plus-circle-fill me-1"></i>+ নতুন বাজার / মোকাম যুক্ত করুন
                                    </button>
                                </div>
                                <div class="row g-2">
                                    <!-- District Dropdown -->
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold text-muted">জেলা</label>
                                        <select class="form-select" value="@selectedDistrict" @onchange="OnDistrictChanged">
                                            <option value="">-- সকল জেলা (সারাদেশ) --</option>
                                            @foreach (var divisionGroup in BangladeshLocationData.Districts.GroupBy(d => d.DivisionBn))
                                            {
                                                <optgroup label="@($"{divisionGroup.Key} বিভাগ ({divisionGroup.First().DivisionEn} Division)")">
                                                    @foreach (var dist in divisionGroup.OrderBy(d => d.NameBn))
                                                    {
                                                        <option value="@dist.DisplayName">@dist.DisplayName</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </div>

                                    <!-- Upazila Dropdown -->
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold text-muted">উপজেলা / থানা</label>
                                        <select class="form-select" value="@selectedUpazila" @onchange="OnUpazilaChanged" disabled="@(districtUpazilas.Count == 0)">
                                            <option value="">-- উপজেলার সকল মোকাম --</option>
                                            @foreach (var u in districtUpazilas)
                                            {
                                                <option value="@u">@u</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Market Dropdown -->
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold text-muted">বাজার / আড়ত <span class="text-danger">*</span></label>
                                        <select class="form-select border-primary" @bind="model.MarketId">
                                            <option value="@Guid.Empty">-- বাজার নির্বাচন করুন --</option>
                                            @foreach (var m in FilteredMarkets)
                                            {
                                                <option value="@m.Id">@m.NameBn (@m.District, @m.Upazila)</option>
                                            }
                                        </select>
                                        <ValidationMessage For="() => model.MarketId" class="text-danger small" />
                                    </div>
                                </div>
                                @if (!FilteredMarkets.Any())
                                {
                                    <div class="small text-muted mt-2">
                                        <i class="bi bi-info-circle me-1"></i> এই এলাকায় কোনো বাজার তালিকাভুক্ত নেই। উপরে <strong>"+ নতুন বাজার / মোকাম যুক্ত করুন"</strong> বাটনে ক্লিক করে সহজে যুক্ত করুন।
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Market Type -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">বাজারের ধরন <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="model.MarketType">
                                <option value="@MarketType.Wholesale">পাইকারি বাজার (Wholesale)</option>
                                <option value="@MarketType.Retail">খুচরা বাজার (Retail)</option>
                            </select>
                        </div>

                        <!-- Observation Date -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">পর্যবেক্ষণের তারিখ <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="model.ObservationDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <ValidationMessage For="() => model.ObservationDate" class="text-danger small" />
                        </div>

                        <!-- Observation Quantity & Unit -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">পর্যবেক্ষিত পরিমাণ <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" class="form-control" @bind="model.ObservedQuantity" @bind:after="UpdateNormalizedPreview" />
                            <ValidationMessage For="() => model.ObservedQuantity" class="text-danger small" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold small">পরিমাপের একক <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="model.ObservedUnit" @bind:after="UpdateNormalizedPreview">
                                <option value="কেজি">কেজি (Kg)</option>
                                <option value="মণ">মণ (Mon = 40 Kg)</option>
                                <option value="কুইন্টাল">কুইন্টাল (Quintal = 100 Kg)</option>
                                <option value="গ্রাম">গ্রাম (Gram)</option>
                                <option value="লিটার">লিটার (Litre)</option>
                                <option value="টি">টি / পিস (Piece)</option>
                                <option value="হালি">হালি (Hali = 4 Pieces)</option>
                                <option value="ডজন">ডজন (Dozen = 12 Pieces)</option>
                            </select>
                        </div>

                        <!-- Observed Price -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">পর্যবেক্ষিত দর (টাকা) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">৳</span>
                                <input type="number" step="0.01" class="form-control fw-bold text-success" @bind="model.ObservedPrice" @bind:after="UpdateNormalizedPreview" />
                            </div>
                            <ValidationMessage For="() => model.ObservedPrice" class="text-danger small" />
                        </div>

                        <!-- Normalized Live Preview Banner -->
                        <div class="col-12">
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #EBF7EE; border: 1px solid #C8E6C9;">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calculator text-success fs-4"></i>
                                    <div>
                                        <div class="text-success fw-bold small">সার্ভার-নর্মালাইজড মানসম্মত প্রতি একক দর (Calculated Standard Price):</div>
                                        <div class="small text-secondary">ভিন্ন ভিন্ন একক (মণ, কেজি) এর মধ্যে তুলনাযোগ্য করতে স্বয়ংক্রিয় হিসাব</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="h4 fw-bold text-success mb-0">৳@previewNormalizedPrice.ToString("F2")</span>
                                    <span class="small text-muted">/ @previewBaseUnit</span>
                                </div>
                            </div>
                        </div>

                        <!-- Price Ranges (Min/Max Optional) -->
                        <div class="col-md-4">
                            <label class="form-label small text-muted">বাজারের সর্বনিম্ন দর (ঐচ্ছিক)</label>
                            <div class="input-group">
                                <span class="input-group-text">৳</span>
                                <input type="number" step="0.01" class="form-control" @bind="model.MinPrice" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-muted">বাজারের সর্বোচ্চ দর (ঐচ্ছিক)</label>
                            <div class="input-group">
                                <span class="input-group-text">৳</span>
                                <input type="number" step="0.01" class="form-control" @bind="model.MaxPrice" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-muted">পণ্যের মান / গ্রেড</label>
                            <select class="form-select" @bind="model.Grade">
                                <option value="@QualityGrade.Premium">প্রিমিয়াম (Premium)</option>
                                <option value="@QualityGrade.GradeA">গ্রেড এ (Grade A)</option>
                                <option value="@QualityGrade.Standard">সাধারণ (Standard)</option>
                            </select>
                        </div>

                        <!-- Notes -->
                        <div class="col-12">
                            <label class="form-label small text-muted">অতিরিক্ত মন্তব্য / পর্যবেক্ষণ নোট</label>
                            <textarea class="form-control" rows="2" placeholder="মোকামের সরবরাহ পরিস্থিতি বা মানের বিশেষ বিবরণ লিখুন..." @bind="model.Notes"></textarea>
                        </div>

                        <!-- Submit Button -->
                        <div class="col-12 mt-4 text-end">
                            <a href="market-prices" class="btn btn-outline-secondary me-2 px-4">বাতিল</a>
                            <button type="submit" class="btn btn-success fw-bold px-4" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>সংরক্ষণ হচ্ছে...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>মূল্য পর্যবেক্ষণ সংরক্ষণ করুন</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

<!-- Modal: Quick Add Crop -->
@if (showQuickAddCropModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 16px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-flower1 text-success me-2"></i>নতুন ফসল যুক্ত করুন
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showQuickAddCropModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(quickCropErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> @quickCropErrorMessage
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">ফসলের বাংলা নাম <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="যেমন: ড্রাগন ফল / পেঁপে / শসা" @bind="quickCropModel.NameBn" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">ইমোজি</label>
                            <input type="text" class="form-control text-center fs-5" placeholder="🌱" @bind="quickCropModel.IconEmoji" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">ক্যাটাগরি</label>
                            <select class="form-select" @bind="quickCropModel.Category">
                                <option value="শাকসবজি (Vegetables)">শাকসবজি (Vegetables)</option>
                                <option value="খাদ্যশস্য (Cereals)">খাদ্যশস্য (Cereals)</option>
                                <option value="ফলমূল (Fruits)">ফলমূল (Fruits)</option>
                                <option value="ডাল (Pulses)">ডাল (Pulses)</option>
                                <option value="মসলা (Spices)">মসলা (Spices)</option>
                                <option value="তৈলবীজ (Oilseeds)">তৈলবীজ (Oilseeds)</option>
                                <option value="অর্থকরী ফসল (Cash Crops)">অর্থকরী ফসল (Cash Crops)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">স্ট্যান্ডার্ড একক</label>
                            <select class="form-select" @bind="quickCropModel.StandardUnit">
                                <option value="কেজি">কেজি (Kg)</option>
                                <option value="মণ">মণ (Mon = 40 Kg)</option>
                                <option value="লিটার">লিটার (Litre)</option>
                                <option value="টি">টি / পিস (Piece)</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showQuickAddCropModal = false">বাতিল</button>
                        <button type="button" class="btn btn-success fw-bold px-4" @onclick="HandleQuickAddCrop" disabled="@isSubmittingQuickCrop">
                            @if (isSubmittingQuickCrop)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>সংরক্ষণ হচ্ছে...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-1"></i>
                                <span>ফসল যুক্ত করুন</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Quick Add Market -->
@if (showAddMarketModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 16px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-shop text-primary me-2"></i>নতুন বাজার / মোকাম যুক্ত করুন
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showAddMarketModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(marketModalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> @marketModalError
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">বাজার বা মোকামের নাম (বাংলা) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="যেমন: শেরপুর কাঁচাবাজার / সান্তাহার মোকাম" @bind="newMarketModel.NameBn" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">ইংরেজি নাম (ঐচ্ছিক)</label>
                            <input type="text" class="form-control" placeholder="e.g. Sherpur Vegetable Market" @bind="newMarketModel.NameEn" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">বাজারের ধরন</label>
                            <select class="form-select" @bind="newMarketModel.MarketType">
                                <option value="@MarketType.Both">উভয় (পাইকারি ও খুচরা)</option>
                                <option value="@MarketType.Wholesale">পাইকারি আড়ত / মোকাম</option>
                                <option value="@MarketType.Retail">খুচরা বাজার</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">জেলা <span class="text-danger">*</span></label>
                            <select class="form-select" value="@newMarketModel.District" @onchange="OnModalMarketDistrictChanged">
                                <option value="">-- জেলা নির্বাচন করুন --</option>
                                @foreach (var divisionGroup in BangladeshLocationData.Districts.GroupBy(d => d.DivisionBn))
                                {
                                    <optgroup label="@($"{divisionGroup.Key} বিভাগ ({divisionGroup.First().DivisionEn} Division)")">
                                        @foreach (var dist in divisionGroup.OrderBy(d => d.NameBn))
                                        {
                                            <option value="@dist.DisplayName">@dist.DisplayName</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">উপজেলা <span class="text-danger">*</span></label>
                            @if (modalMarketUpazilas.Count > 0)
                            {
                                <select class="form-select" @bind="newMarketModel.Upazila">
                                    <option value="">-- উপজেলা নির্বাচন করুন --</option>
                                    @foreach (var u in modalMarketUpazilas)
                                    {
                                        <option value="@u">@u</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" class="form-control" placeholder="উপজেলা লিখুন" @bind="newMarketModel.Upazila" />
                            }
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-muted">নির্দিষ্ট অবস্থান বা ঠিকানা (ঐচ্ছিক)</label>
                            <input type="text" class="form-control" placeholder="যেমন: বাসস্ট্যান্ড সংলগ্ন, থানা রোড" @bind="newMarketModel.AddressDetails" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showAddMarketModal = false">বাতিল</button>
                        <button type="button" class="btn btn-primary fw-bold px-4" @onclick="HandleAddMarket" disabled="@isSubmittingMarket">
                            @if (isSubmittingMarket)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>সংরক্ষণ হচ্ছে...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-1"></i>
                                <span>বাজার সংরক্ষণ করুন</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CreateMarketPriceObservationDto model = new()
    {
        ObservationDate = DateTime.Today,
        ObservedQuantity = 1.0m,
        ObservedUnit = "কেজি",
        Grade = QualityGrade.Standard
    };

    private IReadOnlyList<CropDto> crops = new List<CropDto>();
    private IReadOnlyList<MarketDto> markets = new List<MarketDto>();
    private IReadOnlyList<PriceSourceDto> sources = new List<PriceSourceDto>();

    private string selectedDistrict = string.Empty;
    private string selectedUpazila = string.Empty;
    private IReadOnlyList<string> districtUpazilas = Array.Empty<string>();

    private decimal previewNormalizedPrice = 0m;
    private string previewBaseUnit = "কেজি";

    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string? errorMessage;

    // Quick Crop Modal
    private bool showQuickAddCropModal = false;
    private bool isSubmittingQuickCrop = false;
    private string? quickCropErrorMessage;
    private CreateCropDto quickCropModel = new();

    // Quick Market Modal
    private bool showAddMarketModal = false;
    private bool isSubmittingMarket = false;
    private string? marketModalError;
    private CreateMarketDto newMarketModel = new();
    private IReadOnlyList<string> modalMarketUpazilas = Array.Empty<string>();

    private IEnumerable<MarketDto> FilteredMarkets
    {
        get
        {
            var list = markets.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(selectedDistrict))
            {
                list = list.Where(m => m.District.Contains(selectedDistrict, StringComparison.OrdinalIgnoreCase) ||
                                       selectedDistrict.Contains(m.District, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(selectedUpazila))
            {
                list = list.Where(m => m.Upazila.Contains(selectedUpazila, StringComparison.OrdinalIgnoreCase) ||
                                       selectedUpazila.Contains(m.Upazila, StringComparison.OrdinalIgnoreCase));
            }
            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        crops = await CropService.GetAllCropsAsync();
        markets = await PriceService.GetActiveMarketsAsync();
        sources = await PriceService.GetActivePriceSourcesAsync();

        if (crops.Any()) model.CropId = crops.First().Id;
        if (markets.Any()) model.MarketId = markets.First().Id;
        if (sources.Any()) model.PriceSourceId = sources.First().Id;

        UpdateNormalizedPreview();
    }

    private void OnDistrictChanged(ChangeEventArgs e)
    {
        selectedDistrict = e.Value?.ToString() ?? "";
        districtUpazilas = BangladeshLocationData.GetUpazilasForDistrict(selectedDistrict);
        selectedUpazila = "";

        var firstMarket = FilteredMarkets.FirstOrDefault();
        if (firstMarket != null)
        {
            model.MarketId = firstMarket.Id;
        }
    }

    private void OnUpazilaChanged(ChangeEventArgs e)
    {
        selectedUpazila = e.Value?.ToString() ?? "";
        var firstMarket = FilteredMarkets.FirstOrDefault();
        if (firstMarket != null)
        {
            model.MarketId = firstMarket.Id;
        }
    }

    private void OpenAddMarketModal()
    {
        newMarketModel = new CreateMarketDto
        {
            District = selectedDistrict,
            Upazila = selectedUpazila,
            MarketType = model.MarketType
        };
        modalMarketUpazilas = BangladeshLocationData.GetUpazilasForDistrict(newMarketModel.District);
        marketModalError = null;
        showAddMarketModal = true;
    }

    private void OnModalMarketDistrictChanged(ChangeEventArgs e)
    {
        newMarketModel.District = e.Value?.ToString() ?? "";
        modalMarketUpazilas = BangladeshLocationData.GetUpazilasForDistrict(newMarketModel.District);
        if (modalMarketUpazilas.Count > 0)
        {
            newMarketModel.Upazila = modalMarketUpazilas[0];
        }
        else
        {
            newMarketModel.Upazila = "";
        }
    }

    private async Task HandleAddMarket()
    {
        if (string.IsNullOrWhiteSpace(newMarketModel.NameBn))
        {
            marketModalError = "বাজারের বাংলা নাম আবশ্যক।";
            return;
        }
        if (string.IsNullOrWhiteSpace(newMarketModel.District))
        {
            marketModalError = "জেলা নির্বাচন আবশ্যক।";
            return;
        }
        if (string.IsNullOrWhiteSpace(newMarketModel.Upazila))
        {
            marketModalError = "উপজেলা নির্বাচন আবশ্যক।";
            return;
        }

        isSubmittingMarket = true;
        marketModalError = null;

        try
        {
            var res = await PriceService.CreateMarketAsync(newMarketModel);
            if (res.IsSuccess && res.Value != null)
            {
                markets = await PriceService.GetActiveMarketsAsync();
                selectedDistrict = res.Value.District;
                districtUpazilas = BangladeshLocationData.GetUpazilasForDistrict(selectedDistrict);
                selectedUpazila = res.Value.Upazila;
                model.MarketId = res.Value.Id;
                showAddMarketModal = false;
            }
            else
            {
                marketModalError = res.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            marketModalError = ex.Message;
        }
        finally
        {
            isSubmittingMarket = false;
        }
    }

    private async Task HandleQuickAddCrop()
    {
        if (string.IsNullOrWhiteSpace(quickCropModel.NameBn))
        {
            quickCropErrorMessage = "ফসলের বাংলা নাম আবশ্যক।";
            return;
        }

        isSubmittingQuickCrop = true;
        quickCropErrorMessage = null;

        try
        {
            var res = await CropService.CreateCropAsync(quickCropModel);
            if (res.IsSuccess && res.Value != null)
            {
                crops = await CropService.GetAllCropsAsync();
                model.CropId = res.Value.Id;
                showQuickAddCropModal = false;
                quickCropModel = new();
            }
            else
            {
                quickCropErrorMessage = res.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            quickCropErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingQuickCrop = false;
        }
    }

    private void UpdateNormalizedPreview()
    {
        try
        {
            if (model.ObservedPrice > 0 && model.ObservedQuantity > 0)
            {
                var (norm, baseUnit) = KrishiBondhu.Domain.Common.UnitNormalizer.CalculateNormalizedPrice(
                    model.ObservedPrice, model.ObservedQuantity, model.ObservedUnit);
                previewNormalizedPrice = norm;
                previewBaseUnit = baseUnit;
            }
            else
            {
                previewNormalizedPrice = 0m;
            }
        }
        catch
        {
            previewNormalizedPrice = 0m;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            // Explicitly force UTC Kind to prevent Npgsql DateTimeKind.Local exception
            model.ObservationDate = DateTime.SpecifyKind(model.ObservationDate.Date, DateTimeKind.Utc);
            var userId = CurrentUser.UserId?.ToString() ?? "SystemOperator";
            var result = await PriceService.RecordObservationAsync(model, userId);

            if (result.IsSuccess)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"ত্রুটি ঘটেছে: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        model = new CreateMarketPriceObservationDto
        {
            ObservationDate = DateTime.Today,
            ObservedQuantity = 1.0m,
            ObservedUnit = "কেজি",
            Grade = QualityGrade.Standard
        };
        if (crops.Any()) model.CropId = crops.First().Id;
        if (markets.Any()) model.MarketId = markets.First().Id;
        if (sources.Any()) model.PriceSourceId = sources.First().Id;

        UpdateNormalizedPreview();
        isSuccess = false;
        errorMessage = null;
    }
}
