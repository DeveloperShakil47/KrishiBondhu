@page "/lots/{LotId:guid}/compare"
@inject IOfferComparisonService OfferService
@inject IOrderLifecycleService OrderService
@inject ILocalizationService Loc
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>দরপ্রস্তাব তুলনা ও ডিসিশন ইঞ্জিন | কৃষিবন্ধু</PageTitle>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <a href="lots" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> লট তালিকায় ফিরুন
    </a>
    <span class="badge bg-success-subtle text-success fs-6 fw-bold">
        স্মার্ট কৃষিবন্ধু ডিসিশন ইঞ্জিন
    </span>
</div>

@if (comparison == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="mt-2 text-muted">দরপ্রস্তাব বিশ্লেষণ ও তুলনা লোড হচ্ছে...</p>
    </div>
}
else
{
    <!-- Lot Summary Header Card -->
    <div class="kb-card mb-4" style="background: linear-gradient(135deg, #F0FDF4 0%, #FFFFFF 100%);">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <span class="badge bg-success text-white px-2 py-1 mb-2">লট নম্বর: @comparison.LotNumber</span>
                <h3 class="fw-bold mb-1 text-dark">@comparison.CropNameBn</h3>
                <div class="text-muted small">
                    মোট পরিমাণ: <strong>@comparison.LotQuantityKg.ToString("N0") কেজি</strong> | কৃষকের চাহিদা দর: <strong>৳ @comparison.AskingPricePerKg.ToString("N2") /কেজি</strong>
                </div>
            </div>

            <div class="col-md-5">
                <!-- Farmer Production Cost Input for True Profit Calculation -->
                <div class="p-3 bg-white rounded-3 border shadow-sm">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-calculator-fill text-warning me-1"></i> আপনার প্রতি কেজির উৎপাদন খরচ (ঐচ্ছিক):
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">৳ /কেজি</span>
                        <input type="number" step="0.5" class="form-control" placeholder="যেমন: ২৪.৫০" @bind="farmerProductionCostPerKg" @bind:event="oninput" />
                    </div>
                    <span class="text-muted" style="font-size: 0.78rem;">
                        উৎপাদন খরচ দিলে নিট প্রাপ্তি থেকে প্রকৃত ফসলের নিট মুনাফা প্রদর্শিত হবে।
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert / Important Guidance Banner -->
    <div class="kb-alert kb-alert-warning mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning flex-shrink-0"></i>
        <div>
            <strong>সতর্কতা ও সিদ্ধান্ত নির্দেশনা:</strong>
            কেবল প্রতি কেজির দর বেশি হলেই সেই অফারটি লাভজনক নাও হতে পারে। ক্রেতার পরিবহন, কুলি বা বস্তা খরচ কর্তন বেশি হলে আপনার পকেটে কম টাকা ঢুকবে। কৃষিবন্ধু ইঞ্জিন স্বয়ংক্রিয়ভাবে কর্তন বাদ দিয়ে <strong>প্রকৃত নিট বিক্রয়মূল্য</strong> হিসাব করে সেরা অফার চিহ্নিত করেছে।
        </div>
    </div>

    @if (!comparison.Offers.Any())
    {
        <div class="kb-card text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-bold">এই লটে এখনো কোনো দরপ্রস্তাব জমা পড়েনি</h5>
            <p class="text-muted small">ক্রেতারা দরপ্রস্তাব দিলে এখানে স্বয়ংক্রিয়ভাবে তুলনা দেখতে পাবেন।</p>
            <a href="lots/@LotId" class="btn btn-kb-outline">লটের বিবরণ দেখুন</a>
        </div>
    }
    else
    {
        <!-- Best Offer Highlight Banner -->
        @if (comparison.RecommendedBestOffer != null)
        {
            <div class="card mb-4 border-2 border-success shadow-sm" style="border-radius: var(--kb-radius); background: #F0FDF4;">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <span class="badge bg-success text-white px-3 py-1 fs-6">
                            ⭐ কৃষিবন্ধু প্রস্তাবিত সেরা অফার (Highest Net Proceeds)
                        </span>
                        <span class="text-muted small">অফার কোড: @comparison.RecommendedBestOffer.OfferCode</span>
                    </div>

                    <div class="row align-items-center g-3">
                        <div class="col-md-4">
                            <h5 class="fw-bold text-dark mb-0">@comparison.RecommendedBestOffer.BuyerBusinessName</h5>
                            <span class="text-muted small">ফোন: @comparison.RecommendedBestOffer.BuyerContactPhone | রেটিং: ⭐ @comparison.RecommendedBestOffer.BuyerRating</span>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex justify-content-between small text-muted">
                                <span>প্রস্তাবিত দর:</span>
                                <strong class="text-dark">৳ @comparison.RecommendedBestOffer.OfferedPricePerKg.ToString("N2") /কেজি</strong>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>মোট কর্তন:</span>
                                <span class="text-danger">- ৳ @comparison.RecommendedBestOffer.TotalEstimatedDeductions.ToString("N2")</span>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <div class="text-muted small">কৃষকের আনুমানিক নিট প্রাপ্তি:</div>
                            <h3 class="fw-bold text-success mb-1">৳ @comparison.RecommendedBestOffer.EstimatedNetProceeds.ToString("N2")</h3>

                            @if (farmerProductionCostPerKg > 0)
                            {
                                var totalProdCost = farmerProductionCostPerKg * comparison.RecommendedBestOffer.OfferedQuantityKg;
                                var trueProfit = comparison.RecommendedBestOffer.EstimatedNetProceeds - totalProdCost;
                                <div class="badge bg-warning-subtle text-dark border">
                                    প্রকৃত নিট মুনাফা: ৳ @trueProfit.ToString("N2")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Side-by-Side Offer Comparison Table -->
        <div class="kb-card mb-4">
            <h4 class="kb-card-title mb-3">
                <i class="bi bi-layout-split text-success"></i> দরপ্রস্তাবসমূহের পাশাপাশি বিশদ তুলনা
            </h4>

            <div class="table-responsive">
                <table class="table kb-table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ক্রেতা ও প্রস্তাব</th>
                            <th>দর (৳/কেজি)</th>
                            <th>মোট দর (Gross)</th>
                            <th>পরিবহন কর্তন</th>
                            <th>ওজন ও কুলি কর্তন</th>
                            <th>প্যাকেজিং কর্তন</th>
                            <th>সেবা ফি (০.৫%)</th>
                            <th>আনুমানিক নিট প্রাপ্তি</th>
                            @if (farmerProductionCostPerKg > 0)
                            {
                                <th>প্রকৃত মুনাফা</th>
                            }
                            <th>পদক্ষেপ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var offer in comparison.Offers)
                        {
                            var isBest = comparison.RecommendedBestOffer?.Id == offer.Id;
                            <tr class="@(isBest ? "table-success" : "")">
                                <td>
                                    <strong>@offer.BuyerBusinessName</strong>
                                    @if (isBest)
                                    {
                                        <span class="badge bg-success ms-1">সেরা অফার</span>
                                    }
                                    <div class="text-muted" style="font-size: 0.78rem;">
                                        কোড: @offer.OfferCode | ডেলিভারি: @offer.DeliveryTerms
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold fs-6">৳ @offer.OfferedPricePerKg.ToString("N2")</span>
                                </td>
                                <td>
                                    ৳ @offer.GrossSaleValue.ToString("N2")
                                </td>
                                <td class="text-danger small">
                                    - ৳ @offer.TransportCostDeduction.ToString("N2")
                                </td>
                                <td class="text-danger small">
                                    - ৳ @offer.WeighingAndLaborCostDeduction.ToString("N2")
                                </td>
                                <td class="text-danger small">
                                    - ৳ @offer.PackagingCostDeduction.ToString("N2")
                                </td>
                                <td class="text-muted small">
                                    - ৳ @offer.PlatformFee.ToString("N2")
                                </td>
                                <td>
                                    <strong class="text-success fs-5">
                                        ৳ @offer.EstimatedNetProceeds.ToString("N2")
                                    </strong>
                                </td>
                                @if (farmerProductionCostPerKg > 0)
                                {
                                    var prodCost = farmerProductionCostPerKg * offer.OfferedQuantityKg;
                                    var profit = offer.EstimatedNetProceeds - prodCost;
                                    <td>
                                        <span class="fw-bold @(profit >= 0 ? "text-primary" : "text-danger")">
                                            ৳ @profit.ToString("N2")
                                        </span>
                                    </td>
                                }
                                <td>
                                    @if (offer.Status == OfferStatus.Submitted || offer.Status == OfferStatus.UnderReview)
                                    {
                                        <button class="btn btn-sm btn-success fw-bold text-nowrap" @onclick="@(() => ConfirmAcceptOffer(offer))" disabled="@isProcessing">
                                            <i class="bi bi-check-circle me-1"></i> গ্রহণ করুন
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@offer.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- Accept Offer Confirmation Dialog Modal -->
@if (selectedOfferToAccept != null)
{
    <div class="kb-modal-backdrop">
        <div class="kb-modal-content">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h4 class="fw-bold mb-0 text-success">
                    <i class="bi bi-shield-lock-fill me-2"></i>দরপ্রস্তাব গ্রহণের চুক্তি অনুমোদন
                </h4>
                <button type="button" class="btn-close" @onclick="@(() => selectedOfferToAccept = null)"></button>
            </div>

            <div class="alert alert-info py-2 small mb-3">
                <i class="bi bi-info-circle-fill me-1"></i>
                এই প্রস্তাবটি গ্রহণ করলে একটি <strong>অপরিবর্তনযোগ্য চুক্তিভিত্তিক অর্ডার</strong> তৈরি হবে। প্রস্তাবের সকল শর্ত ও কর্তনের স্ন্যাপশট সংরক্ষিত হবে।
            </div>

            <div class="p-3 bg-light rounded-3 mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">ক্রেতা:</span>
                    <strong>@selectedOfferToAccept.BuyerBusinessName</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">দর ও পরিমাণ:</span>
                    <strong>৳ @selectedOfferToAccept.OfferedPricePerKg.ToString("N2") /কেজি (@selectedOfferToAccept.OfferedQuantityKg.ToString("N0") কেজি)</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">মোট কর্তনসমূহ:</span>
                    <span class="text-danger">- ৳ @selectedOfferToAccept.TotalEstimatedDeductions.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between border-top pt-2">
                    <span class="fw-bold">প্রত্যাশিত নিট প্রাপ্তি:</span>
                    <strong class="text-success fs-5">৳ @selectedOfferToAccept.EstimatedNetProceeds.ToString("N2")</strong>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(acceptErrorMessage))
            {
                <div class="alert alert-danger py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle me-1"></i> @acceptErrorMessage
                </div>
            }

            <div class="d-flex justify-content-end gap-2 border-top pt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="@(() => selectedOfferToAccept = null)">বাতিল</button>
                <button type="button" class="btn btn-kb-primary" @onclick="ExecuteAcceptOffer" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>অর্ডার তৈরি হচ্ছে...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill me-1"></i>
                        <span>নিশ্চিতভাবে গ্রহণ ও অর্ডার তৈরি করুন</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid LotId { get; set; }

    private OfferComparisonSummaryDto? comparison;
    private decimal farmerProductionCostPerKg = 24.50m;
    private BuyerOfferDto? selectedOfferToAccept;
    private bool isProcessing;
    private string? acceptErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadComparison();
    }

    private async Task LoadComparison()
    {
        comparison = await OfferService.GetOfferComparisonForLotAsync(LotId, farmerProductionCostPerKg);
    }

    private void ConfirmAcceptOffer(BuyerOfferDto offer)
    {
        selectedOfferToAccept = offer;
        acceptErrorMessage = null;
    }

    private async Task ExecuteAcceptOffer()
    {
        if (selectedOfferToAccept == null) return;

        isProcessing = true;
        acceptErrorMessage = null;

        try
        {
            var acceptDto = new AcceptOfferDto
            {
                BuyerOfferId = selectedOfferToAccept.Id,
                IdempotencyKey = $"ACCEPT-{selectedOfferToAccept.Id}-{Guid.NewGuid():N}"
            };

            var result = await OrderService.AcceptOfferAndCreateOrderAsync(acceptDto);
            if (result.Succeeded && result.Data != null)
            {
                selectedOfferToAccept = null;
                Nav.NavigateTo($"orders/{result.Data.Id}");
            }
            else
            {
                acceptErrorMessage = result.Errors.FirstOrDefault() ?? "দরপ্রস্তাব গ্রহণ করা সম্ভব হয়নি।";
            }
        }
        catch (Exception ex)
        {
            acceptErrorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
}
